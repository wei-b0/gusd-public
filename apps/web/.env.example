# Oracle integration (values are inlined at BUILD time — restart the dev
# server / rebuild after changing them).

# Data source for the reference layer. "oracle" (default) overlays the live
# oracle feed on the simulated market layer for every settlement panel
# (H100/H200/L40S/RTX 4090); "mock" runs the fully simulated
# universe (deterministic, offline, CI).
# NEXT_PUBLIC_DATA_SOURCE=mock

# Oracle API base URL (apps/oracle: `pnpm dev:oracle`, default :8080).
# A zero-dep fixture server speaking the same wire format lives at
# apps/web/scripts/mock-oracle.mjs (`pnpm web:fixture`, default :8081).
# NEXT_PUBLIC_ORACLE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Auth / wallet / chain (values inlined at BUILD time — restart the dev
# server after changing the NEXT_PUBLIC_* ones).
# ---------------------------------------------------------------------------

# Privy app id. ABSENT ⇒ Privy disabled ⇒ the demo mode (prototype session,
# no wallet) — CI builds this way. Set it to enable real authentication.
# NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect relay project id. ABSENT ⇒ the connect dialog hides the
# WalletConnect row (injected wallets and embedded wallets suffice today).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The chain the desk trades on (decimal). Default 31337 (local Anvil, the
# only chain the monorepo deploys to today). Robinhood Chain 46630 (testnet)
# is the first real target; Base Sepolia 84532 / Base 8453 / Robinhood 4663
# are registry entries — selecting one also requires an RPC URL below and a
# committed deployment record (apps/contracts/deployments/<id>.json).
# NEXT_PUBLIC_CHAIN_ID=31337

# RPC overrides. 31337 defaults to the local node; remote chains MUST be
# pointed at a real endpoint or the chain stays disabled.
# NEXT_PUBLIC_RPC_URL_31337=http://127.0.0.1:8545
# NEXT_PUBLIC_RPC_URL_84532=
# NEXT_PUBLIC_RPC_URL_8453=
# Robinhood Chain (Arbitrum Orbit L2; USDG is the canonical reserve asset):
# NEXT_PUBLIC_RPC_URL_46630=https://rpc.testnet.chain.robinhood.com
# NEXT_PUBLIC_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# Cross-chain funding (the gUSD mint tab's Across-powered panel) needs no
# env — it is capability-gated per chain in the registry (mainnets with
# coverage get the live flow, Robinhood testnet guidance-only, others
# nothing) and the adapter's origin tokens are hand-vetted in code.

# Dev-only preview of the funding panels on the configured chain (Anvil
# by default): "live" mounts the Across flow, "guidance" the testnet note.
# Real quotes have no Anvil routes — the panel honestly reports it. NEVER
# set in production.
# NEXT_PUBLIC_ENABLE_FUNDING_DEV=live

# Dev-only Transactions panel (real self-transfer txs against the local
# node — the lifecycle proof surface). Absent ⇒ panel hidden.
# NEXT_PUBLIC_ENABLE_TX_DEV=1

# Indexer base URL (the user-events wire contract lives in
# src/domain/indexer.ts). Points at the ORACLE's /v1/protocol proxy — the
# single API base the app talks to; Envio itself has no public HTTP.
# When set, the STATE reads (balances, positions, gusdState, sgusdState)
# are answered from the indexed views via contractReadsWithIndexer(), each
# falling back to direct RPC on any indexed failure. The same URL also
# feeds the protocol-market layer (src/data/protocol/): the terminal AMM
# tape, cost basis (avg entry / realized PnL), the merged wallet activity
# ledger, and the 24h volume / in-range depth enrichment. Execution paths
# (quotes, allowances, balanceOf, staleness gate) always stay on RPC.
# ABSENT ⇒ everything indexed is inert: no protocol network calls, the
# tape is empty, ledgers keep "this session" provenance, and user state
# comes from direct contract reads. Canonical benchmark prices never come
# from this URL — they stay on /v1/prices*.
# NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:8080/v1/protocol

# ---------------------------------------------------------------------------
# Server-only secrets (never NEXT_PUBLIC_; used by the API route handlers).
# ---------------------------------------------------------------------------

# Privy server credentials — PRIVY_APP_SECRET is required when the client
# app id is set. The verification key (SPKI PEM, from the Privy dashboard)
# enables offline token verification and is preferred over network checks.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_VERIFICATION_KEY=

# Postgres for the identity boundary (user_wallets). Defaults to the local
# docker compose database.
# DATABASE_URL=postgres://gusd:gusd@localhost:54329/gusd
