{
  "name": "@gusd/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "config:generate": "tsx scripts/emit-abis.ts && tsx scripts/generate-config.ts",
    "dev": "pnpm config:generate && envio dev",
    "start": "pnpm config:generate && envio start",
    "codegen": "pnpm config:generate && envio codegen",
    "build": "INDEXER_OFFLINE_CODEGEN=1 pnpm codegen && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "INDEXER_OFFLINE_CODEGEN=1 pnpm codegen && tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:anvil": "RUN_ANVIL_TESTS=1 vitest run --passWithNoTests"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@gusd/eslint-config": "workspace:*",
    "@gusd/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/pg": "^8.15.0",
    "envio": "3.10.0",
    "eslint": "10.9.1",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  }
}
