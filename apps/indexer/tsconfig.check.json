{
  "extends": "./tsconfig.json",
  "include": [
    "src",
    "ponder.config.ts",
    "ponder.schema.ts",
    "ponder-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
