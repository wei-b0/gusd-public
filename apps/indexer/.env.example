# Indexer environment. Ponder loads .env.local at CLI boot — BEFORE the
# config file executes — so DATABASE_SCHEMA / DATABASE_VIEWS_SCHEMA must be
# set here (dev) or as real env vars (prod). A missing DATABASE_SCHEMA makes
# `ponder dev` fall back to the "public" schema, which the indexer must never
# write to; the config refuses to boot without these.

# Postgres connection. Falls back to DATABASE_URL, then the house default.
# The indexer owns ONLY its own schemas — public.* is never touched.
#INDEXER_DATABASE_URL=postgres://gusd:gusd@localhost:54329/gusd

# Ponder schemas (required): one per DEPLOYMENT (immutable history, drop to
# re-backfill) plus the STABLE views schema Fastify reads — views are built
# by `ponder start` once backfill completes (dev never creates views).
DATABASE_SCHEMA=gusd_index_dev_v2
DATABASE_VIEWS_SCHEMA=gusd_index_dev
# House-name aliases (INDEXER_DEPLOYMENT_SCHEMA / INDEXER_VIEWS_SCHEMA) are
# accepted; setting both spellings with different values is fatal.

# One chain per process: 31337 (dev/anvil) | 46630 (testnet) | 4663 (mainnet).
#INDEXER_CHAINS=31337

# Required for every chain listed above.
INDEXER_RPC_URL_31337=http://127.0.0.1:8545

# Optional: cap eth_getLogs ranges (rate-limited public endpoints).
#INDEXER_MAX_BLOCK_RANGE_31337=2000

# Optional: where deployments/<chainId>.json lives (default resolves
# ../contracts/deployments from this app; set for containers).
#INDEXER_DEPLOYMENTS_DIR=/app/apps/contracts/deployments

# Ponder HTTP (health/ready/status/metrics) — internal/private network only.
# PORT is Ponder's native server port variable (default 42069).
#PORT=42069

# Ponder logging.
#PONDER_LOG_LEVEL=info
