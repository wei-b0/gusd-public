# Oracle service
DATABASE_URL=postgres://gusd:gusd@localhost:54329/gusd
PORT=8080
LOG_LEVEL=info

# Publisher service (shares DATABASE_URL above — the publish ledger lives in
# the same Postgres; PUBLISHER_ORACLE_URL points at the index API)
PUBLISHER_ORACLE_URL=http://localhost:8080

# Publisher target: "mock" (default, sha256 txRef) or "chain" (signs and
# submits GPUPriceOracle.publish onchain). Anything else refuses to start.
PUBLISHER_TARGET=mock

# Required when PUBLISHER_TARGET=chain
PUBLISHER_RPC_URL=http://127.0.0.1:8545
# Publisher EOA key — publish-role only, never the owner/deployer on a live chain
PUBLISHER_PRIVATE_KEY=
PUBLISHER_ORACLE_ADDRESS=
PUBLISHER_CHAIN_ID=31337
# Receipt-wait limit in ms (default 120000)
PUBLISHER_TX_TIMEOUT_MS=120000

# Optional provider keys (collectors degrade to unauthenticated behaviour without them)
VAST_API_KEY=
RUNPOD_API_KEY=
PRIMEINTELLECT_API_KEY=
HYPERBOLIC_API_KEY=
