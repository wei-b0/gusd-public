# Oracle service
DATABASE_URL=postgres://gusd:gusd@localhost:54329/gusd
PORT=8080
LOG_LEVEL=info
# Must match the deployed GpuOracle's epoch length (default 60s) — defines
# the acceptance window GET /v1/prices/:gpu/attestation serves into
ORACLE_EPOCH_LENGTH=60

# Attestor service (shares DATABASE_URL above — the reports ledger lives in
# the same Postgres; ATTESTOR_ORACLE_URL points at the index API for
# contributor source health only)
ATTESTOR_ORACLE_URL=http://localhost:8080

# Attestor EOA key — signing only; the process never broadcasts a transaction.
# Must match the oracleAttestor recorded at deploy, or every signature is
# un-consumable on-chain.
ATTESTOR_PRIVATE_KEY=
# The EIP-712 domain: chain id + the deployed GpuOracle (verifyingContract)
ATTESTOR_ORACLE_ADDRESS=
ATTESTOR_CHAIN_ID=31337
# Must match the deployed GpuOracle's constructor values (defaults 60s / 300s)
ATTESTOR_EPOCH_LENGTH=60
ATTESTOR_MAX_OBSERVATION_AGE=300
# Optional read-only RPC: boots the attestor only after its key/chain-id/
# epoch grid match the DEPLOYED GpuOracle (eth_chainId + 3 eth_calls — it
# never broadcasts). On a production chain set this to the chain RPC; unset
# means a wrong key would only surface as un-consumable signatures.
# ATTESTOR_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Quality thresholds (ATTESTOR_MIN_CONTRIBUTORS / MAX_DISPERSION /
# MAX_BAND_WIDTH_PCT / MAX_FRESHNESS_MS / MAX_JUMP_PCT) only annotate the
# publish_violations audit ledger — they never block attestation. The sole
# hard stops are a missing price and an observation beyond the contract's
# floor: neither leaves anything honest to sign.

# Provider keys — the fleet's only REQUIRED key is PRIMEINTELLECT_API_KEY
# (absent ⇒ every run records auth_failed); Hyperbolic is optional. See
# docs/oracle/PROVIDERS.md for the authoritative matrix.
PRIMEINTELLECT_API_KEY=
HYPERBOLIC_API_KEY=

# Indexer service (31337 dev | 46630 testnet | 4663 mainnet).
INDEXER_SCHEMA=gusd_index_envio_docker_v2
INDEXER_CHAIN_ID=31337
# The indexer's sync RPC (required for 31337/46630; optional HyperSync
# fallback for 4663).
INDEXER_RPC_URL=http://host.docker.internal:8545
# Oracle-only: the RPC its health probe calls to timestamp the indexed block.
INDEXER_STATUS_RPC_URL=http://host.docker.internal:8545
INDEXER_LOG_LEVEL=info

# Required for chain 4663 HyperSync.
ENVIO_API_TOKEN=

# Keeper service — the perp executor (candidate stream → offline evaluation
# → sim-gated broadcasts). Shares DATABASE_URL / INDEXER_SCHEMA above (it
# reads the indexer's perp entities directly) and ORACLE_HTTP_URL below
# (attestations fetched only when work exists).
ORACLE_HTTP_URL=http://localhost:8080
# Hot EOA key — the ONLY backend key that broadcasts. Must be funded; on the
# dev posture defaults to anvil account #1 (see infra/docker-compose.yml).
# NEVER a protocol owner/attestor key: the engine's permissionless execution
# is the authorization, and the escrowed fee is the keeper's income.
KEEPER_PRIVATE_KEY=
KEEPER_RPC_URL=http://host.docker.internal:8545
KEEPER_CHAIN_ID=31337
# Read from apps/contracts/deployments/<chainId>.json on boot (perpEngine) —
# override only for a non-standard deployment layout.
# KEEPER_DEPLOYMENTS_DIR=
# Gas ceiling (gwei) — candidates above it wait rather than burn the hot key
KEEPER_MAX_FEE_GWEI=100
# Health alarm floor (ETH) for the hot key
KEEPER_MIN_BALANCE_ETH=0.1
# Full-book reload cadence (seconds) — the safety net under event reconciliation
KEEPER_RELOAD_SEC=30
