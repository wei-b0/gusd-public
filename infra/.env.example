# Oracle service
DATABASE_URL=postgres://gusd:gusd@localhost:54329/gusd
PORT=8080
LOG_LEVEL=info

# Publisher service (shares DATABASE_URL above — the publish ledger lives in
# the same Postgres; PUBLISHER_ORACLE_URL points at the index API)
PUBLISHER_ORACLE_URL=http://localhost:8080

# Publisher target: "mock" (default, sha256 txRef) or "chain" (signs and
# submits GPUPriceOracle.publish onchain). Anything else refuses to start.
PUBLISHER_TARGET=mock

# Required when PUBLISHER_TARGET=chain
PUBLISHER_RPC_URL=http://127.0.0.1:8545
# Publisher EOA key — publish-role only, never the owner/deployer on a live chain
PUBLISHER_PRIVATE_KEY=
PUBLISHER_ORACLE_ADDRESS=
PUBLISHER_CHAIN_ID=31337
# Receipt-wait limit in ms (default 120000)
PUBLISHER_TX_TIMEOUT_MS=120000

# PROTOCOL.md §11 publication trigger: publish on a deviation of at least
# this percent vs the last published figure (0.5 = 50 bps), or after the
# heartbeat (~24h) — whichever first. Between triggers the on-chain figure
# is already current and the tx is suppressed (gas). Quality thresholds
# (PUBLISHER_MIN_CONTRIBUTORS / MAX_DISPERSION / MAX_BAND_WIDTH_PCT /
# MAX_FRESHNESS_MS / MAX_JUMP_PCT) only annotate the publish_violations
# audit ledger — they never block publication.
PUBLISHER_MIN_DEVIATION_PCT=0.5
PUBLISHER_HEARTBEAT_MS=86400000

# Optional provider keys (collectors degrade to unauthenticated behaviour without them)
VAST_API_KEY=
RUNPOD_API_KEY=
PRIMEINTELLECT_API_KEY=
HYPERBOLIC_API_KEY=

# Indexer service (31337 dev | 46630 testnet | 4663 mainnet).
INDEXER_SCHEMA=gusd_index_envio_docker_v1
INDEXER_CHAIN_ID=31337
# The indexer's sync RPC (required for 31337/46630; optional HyperSync
# fallback for 4663).
INDEXER_RPC_URL=http://host.docker.internal:8545
# Oracle-only: the RPC its health probe calls to timestamp the indexed block.
INDEXER_STATUS_RPC_URL=http://host.docker.internal:8545
INDEXER_LOG_LEVEL=info

# Required for chain 4663 HyperSync.
ENVIO_API_TOKEN=
