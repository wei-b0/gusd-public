{
  "name": "@gusd/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/cli.ts migrate"
  },
  "dependencies": {
    "@gusd/gpu-catalog": "workspace:*",
    "@gusd/types": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@gusd/eslint-config": "workspace:*",
    "@gusd/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "10.9.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  }
}
